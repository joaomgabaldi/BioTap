<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BioTap.Service</RootNamespace>
    <!-- SetupAPI structs differ per architecture; the service is installed on x64 only -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <!-- publish.ps1 publica com -r win-x64; declarado aqui, o packages.lock.json fica igual no build e no publish -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BioTap.Core\BioTap.Core.csproj" />
    <InternalsVisibleTo Include="BioTap.Service.Tests" />
  </ItemGroup>
</Project>

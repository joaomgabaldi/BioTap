<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BioTap.App</RootNamespace>
    <AssemblyName>BioTap</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without it `dotnet publish` leaves out BioTap.pri (app resources + compiled XAML): controls like
         NavigationView then find no template and WinUI fail-fasts natively (0xC000027B), with nothing logged -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- The logon task starts this elevated process with the user's environment (HKCU\Environment, writable without
         admin). Self-contained: the host no longer follows DOTNET_ROOT to another runtime; no startup hooks:
         DOTNET_STARTUP_HOOKS cannot load a DLL into it -->
    <SelfContained>true</SelfContained>
    <StartupHookSupport>false</StartupHookSupport>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BioTap.Core\BioTap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\BioTap.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>

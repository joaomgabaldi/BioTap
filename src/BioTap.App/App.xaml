<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BioTap.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Destaque lilás no lugar da cor de destaque do Windows -->
                    <Color x:Key="SystemAccentColor">#7961B0</Color>
                    <Color x:Key="SystemAccentColorLight1">#8B73C2</Color>
                    <Color x:Key="SystemAccentColorLight2">#7961B0</Color>
                    <Color x:Key="SystemAccentColorLight3">#B5A0D8</Color>
                    <Color x:Key="SystemAccentColorDark1">#6A53A0</Color>
                    <Color x:Key="SystemAccentColorDark2">#5A458A</Color>
                    <Color x:Key="SystemAccentColorDark3">#4A3873</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7961B0" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8B73C2" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6A53A0" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6E0F2" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B5A0D8" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B5A0D8" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#9E86CE" />

                    <!-- Preferências: navegação #202020, conteúdo #252525, item selecionado discreto, indicador lilás -->
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#202020" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#202020" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#252525" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#9E86CE" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F2F2F2" />

                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#252525" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2D2D2D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Paleta do BioTap (chumbo + lilás). O código C# lê estas chaves por Shell/Theme.cs. -->
            <Color x:Key="BioTapTitleBarColor">#202020</Color>
            <Color x:Key="BioTapContentColor">#252525</Color>
            <Color x:Key="BioTapCardColor">#2D2D2D</Color>
            <Color x:Key="BioTapCardHoverColor">#333333</Color>
            <Color x:Key="BioTapControlColor">#363636</Color>
            <Color x:Key="BioTapGlassColor">#262626</Color>
            <Color x:Key="BioTapAccentColor">#7961B0</Color>
            <Color x:Key="BioTapAccentHoverColor">#8B73C2</Color>
            <Color x:Key="BioTapAccentPressedColor">#6A53A0</Color>
            <!-- Lilás mais claro só para ícones pequenos e indicadores finos (contraste sobre o chumbo) -->
            <Color x:Key="BioTapAccentLightColor">#B5A0D8</Color>
            <Color x:Key="BioTapAccentLineColor">#9E86CE</Color>
            <Color x:Key="BioTapTextColor">#F2F2F2</Color>
            <Color x:Key="BioTapTextMutedColor">#AAAAAA</Color>
            <Color x:Key="BioTapLineColor">#12FFFFFF</Color>
            <Color x:Key="BioTapDividerColor">#19FFFFFF</Color>
            <Color x:Key="BioTapGlassBorderColor">#26FFFFFF</Color>

            <SolidColorBrush x:Key="BioTapTitleBarBrush" Color="{StaticResource BioTapTitleBarColor}" />
            <SolidColorBrush x:Key="BioTapContentBrush" Color="{StaticResource BioTapContentColor}" />
            <SolidColorBrush x:Key="BioTapCardBrush" Color="{StaticResource BioTapCardColor}" />
            <SolidColorBrush x:Key="BioTapCardHoverBrush" Color="{StaticResource BioTapCardHoverColor}" />
            <SolidColorBrush x:Key="BioTapControlBrush" Color="{StaticResource BioTapControlColor}" />
            <SolidColorBrush x:Key="BioTapAccentBrush" Color="{StaticResource BioTapAccentColor}" />
            <SolidColorBrush x:Key="BioTapAccentLightBrush" Color="{StaticResource BioTapAccentLightColor}" />
            <SolidColorBrush x:Key="BioTapAccentLineBrush" Color="{StaticResource BioTapAccentLineColor}" />
            <SolidColorBrush x:Key="BioTapTextBrush" Color="{StaticResource BioTapTextColor}" />
            <SolidColorBrush x:Key="BioTapTextMutedBrush" Color="{StaticResource BioTapTextMutedColor}" />
            <SolidColorBrush x:Key="BioTapLineBrush" Color="{StaticResource BioTapLineColor}" />
            <SolidColorBrush x:Key="BioTapDividerBrush" Color="{StaticResource BioTapDividerColor}" />
            <SolidColorBrush x:Key="BioTapCardHoverBorderBrush" Color="#357961B0" />
            <SolidColorBrush x:Key="BioTapTileBrush" Color="#1A7961B0" />
            <SolidColorBrush x:Key="BioTapTileBorderBrush" Color="#207961B0" />
            <SolidColorBrush x:Key="BioTapGhostHoverBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="BioTapPanelTileHoverBrush" Color="#257961B0" />
            <SolidColorBrush x:Key="BioTapPanelTilePressedBrush" Color="#457961B0" />
            <SolidColorBrush x:Key="BioTapPanelTileHoverBorderBrush" Color="#09FFFFFF" />
            <SolidColorBrush x:Key="BioTapErrorBrush" Color="#E57373" />

            <CornerRadius x:Key="BioTapCardRadius">11</CornerRadius>
            <CornerRadius x:Key="BioTapTileRadius">9</CornerRadius>


            <!-- Área clicável sem aparência própria (região principal do cartão de ação) -->
            <Style x:Key="BioTapPlainButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Background="{TemplateBinding Background}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botão discreto só com ícone (Testar, Opções, engrenagem) -->
            <Style x:Key="BioTapGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource BioTapTextMutedBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.15" />
                                </Grid.BackgroundTransition>
                                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource BioTapGhostHoverBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource BioTapTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource BioTapDividerBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource BioTapTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quadrado de ação do painel: fundo ausente em repouso, lilás discreto no hover, traço lilás embaixo -->
            <Style x:Key="BioTapPanelTileStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#EAEAEA" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="72" />
                <Setter Property="CornerRadius" Value="{StaticResource BioTapTileRadius}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.15" />
                                </Grid.BackgroundTransition>
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                <Rectangle x:Name="Line" Width="13" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,5"
                                           VerticalAlignment="Bottom" Fill="{StaticResource BioTapAccentLineBrush}" Opacity="0" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource BioTapPanelTileHoverBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource BioTapPanelTileHoverBorderBrush}" />
                                                <Setter Target="Line.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource BioTapPanelTilePressedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource BioTapPanelTileHoverBorderBrush}" />
                                                <Setter Target="Line.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rótulo de seção ("SUAS AÇÕES"): 10 px, espaçado, cinza -->
            <Style x:Key="BioTapSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="160" />
                <Setter Property="Foreground" Value="{StaticResource BioTapTextMutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
